{
  "manifest_version": 3,
  "name": "Job Extractor \u2013 OnlineJobs.ph & JobStreet",
  "version": "1.1.0",
  "description": "Extract structured information from an individual OnlineJobs.ph or JobStreet Philippines job listing as JSON.",
  "permissions": [
    "activeTab",
    "scripting",
    "downloads",
    "clipboardWrite"
  ],
  "action": {
    "default_title": "Extract job as JSON",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://onlinejobs.ph/*",
        "https://*.onlinejobs.ph/*",
        "https://ph.jobstreet.com/*",
        "https://jobstreet.com/*",
        "https://*.jobstreet.com/*",
        "https://jobstreet.com.ph/*",
        "https://*.jobstreet.com.ph/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}